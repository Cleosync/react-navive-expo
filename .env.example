# Copy this file to .env for local development (never commit .env).
# In CI and EAS builds, these are injected from EAS Secrets / GitHub Actions secrets —
# see AGENTS.md "Secrets" section for how to set them.

# Public — safe to embed in the built app bundle.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=development

# Build-time only — read by the Sentry CLI during `eas build`, never bundled into the app.
# Set these as EAS secrets (`eas secret:create`), not in this file.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
